# Which environment config to use: prod | qa | dev  (see config/env.config.js)
# "prod" points at the live public ParaBank instance.
ENV=prod

# Override these only if you deploy your own ParaBank instance
# (see https://github.com/parasoft/parabank) for a QA or local instance.
# QA_BASE_URL=
# QA_API_BASE_URL=
# DEV_BASE_URL=http://localhost:8080/parabank
# DEV_API_BASE_URL=http://localhost:8080/parabank/services/bank

TEST_TIMEOUT=30000
TEST_RETRIES=1
